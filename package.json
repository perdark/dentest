{
  "name": "zuha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "eslint",
    "pin:reset": "tsx scripts/reset-pin.ts",
    "typecheck": "tsc --noEmit",
    "test:settlement": "NODE_OPTIONS=--conditions=react-server tsx --test tests/settlement-payout.test.ts",
    "test:payments": "NODE_OPTIONS=--conditions=react-server tsx --test tests/payment-collection.test.ts",
    "test:audit": "NODE_OPTIONS=--conditions=react-server tsx --test tests/audited-mutations.test.ts",
    "test:xrays": "NODE_OPTIONS=--conditions=react-server tsx --test tests/xray-income.test.ts",
    "test:ortho": "NODE_OPTIONS=--conditions=react-server tsx --test tests/ortho-open-total.test.ts",
    "test": "npm run test:settlement && npm run test:payments && npm run test:audit && npm run test:xrays && npm run test:ortho && npm run test:lab && npm run test:dates && npm run test:wipe && npm run test:restore",
    "verify": "rm -f verify.db verify.db-shm verify.db-wal && ZUHA_DB=./verify.db drizzle-kit migrate && ZUHA_DB=./verify.db tsx lib/db/seed.ts && ZUHA_DB=./verify.db NODE_OPTIONS=--conditions=react-server tsx scripts/verify.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:server": "rm -f e2e.db e2e.db-shm e2e.db-wal && ZUHA_DB=./e2e.db drizzle-kit migrate && ZUHA_DB=./e2e.db tsx lib/db/seed.ts && ZUHA_DB=./e2e.db ZUHA_BACKUPS_DIR=./e2e-backups ZUHA_DIST_DIR=.next-e2e next dev -p 3100",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx lib/db/seed.ts",
    "db:setup": "drizzle-kit migrate && tsx lib/db/seed.ts",
    "db:demo": "NODE_OPTIONS=--conditions=react-server tsx scripts/demo.ts",
    "db:demo:clear": "NODE_OPTIONS=--conditions=react-server tsx scripts/demo.ts --clear",
    "stage": "node scripts/stage-app.mjs",
    "app:build": "npm run build && npm run stage",
    "app:start": "electron .",
    "dist:win": "npm run build && ZUHA_TARGET_PLATFORM=win32 ZUHA_TARGET_ARCH=x64 npm run stage && electron-builder --win --x64",
    "dist:linux": "npm run app:build && electron-builder --linux dir",
    "test:lab": "NODE_OPTIONS=--conditions=react-server tsx --test tests/lab-dues.test.ts",
    "test:dates": "NODE_OPTIONS=--conditions=react-server tsx --test tests/date-display.test.ts",
    "test:wipe": "NODE_OPTIONS=--conditions=react-server tsx --test tests/wipe-records.test.ts",
    "test:restore": "NODE_OPTIONS=--conditions=react-server tsx --test tests/backup-restore.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "main": "electron/main.js",
  "description": "نظام سجلات وحسابات عيادة الأسنان — يعمل محلياً بدون إنترنت",
  "author": {
    "name": "Zuha"
  },
  "build": {
    "appId": "iq.zuha.clinic",
    "productName": "Zuha",
    "copyright": "Zuha",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "!electron/اقرأني.txt",
      "!**/*.map",
      "!node_modules/**/*",
      {
        "from": "build/app",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "Zuha-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "زُهى",
      "installerLanguages": [
        "en_US"
      ],
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Office",
      "icon": "electron/icon.png"
    },
    "asar": false,
    "extraFiles": [
      {
        "from": "electron/اقرأني.txt",
        "to": "اقرأني.txt"
      }
    ]
  }
}
