# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Build dir for the e2e dev server — Next 16 dev locks one build dir per
# process, so the e2e server needs its own (see ZUHA_DIST_DIR in e2e:server).
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Zuha local data (never commit clinic data or backups)
zuha.db
*.db
*.db-shm
*.db-wal
/backups/

# verify scratch DB
verify.db
verify.db-shm
verify.db-wal

# Playwright (e2e.db itself is already covered by *.db above)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/
/e2e-backups/

# ── مخرجات البناء ──
# 🔴 `dist/` كان يخلي `git status` بـ1658 سطراً، 1561 منها `dist/win-unpacked`
# — أي ملف حقيقي يضيع بين ضجيج البناء، و`git add -A` يبلع حزمة ويندوز كاملة.
/dist/
/build/

# ── مادة العيادة الأصلية — clinic source material ──
# 🔴 These are the raw client recordings the brief was decoded FROM: walkthrough
#    videos of the clinic, stills of its paper ledgers (real patient names and
#    amounts), and the owner's audio note. They were tracked until 2026-09-21
#    and were removed from the whole history before the first push, because the
#    GitHub repo is public. BRIEF.md describes what they contain — that is the
#    only form this material belongs in here. Keep the originals off git.
/frames/
/transcripts/
/transcripts_v2/
*.MOV
*.m4a
photo_*.jpg

# Backups written by the Playwright suite. `scripts/e2e-server.mjs` points
# ZUHA_BACKUPS_DIR here so a backup test can never write into the clinic's
# real backups/ — the folder it produces is test output, not records.
/e2e-backups/

# Local scratch: preview databases and throwaway launchers. Never shipped.
/.scratch/
